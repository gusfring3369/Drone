    { "name": "water_tower",       "north": 15,  "east": 55,  "size_n": 10, "size_e": 10, "height": 35 },
    { "name": "office_block_b",    "north": 80,  "east": 62,  "size_n": 24, "size_e": 16, "height": 32 },
    { "name": "warehouse_c",       "north": 95,  "east": 20,  "size_n": 18, "size_e": 26, "height": 25 },
